	"Main Function": {
		"prefix": ["@$main", "int main", "main"],
		"body": [
			"#include <stdio.h>",
			"",
			"int main(){",
			"\t$0",
			"",
			"return 0;",
			"}"
		],
		"description": "main function"
	},

	"For loop": {
		"prefix": ["for(", "@$for"],
		"body": [
			"for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++){",
			"\t$0",
			"}"
		]
	},

	"Fast Snprintf": {
		"prefix": ["@$snp", "snp", "snprintf"],
		"body" : [
			"snprintf(\"${1:buffer}, ${2:size}, ${3:string}, $4\");",
			"$0"
		],
		"description": "Snprintf"
	}
}