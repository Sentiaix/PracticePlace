{
	/*
					:::	Rules :::
		'#(sharp)' 접두사를 갖는 경우는 메인 함수/큰 틀을 
		호출할때 쓰는 경우입니다.

		'@(at)' 접두사를 쓰는 경우는 함수 내에서 간단한데
		자주쓰는 내부함수들을 호출할 때 쓰는 경우입니다.
	*/

	"Main Function": {
		"scope": "c",
		"prefix": ["##int main", "#main()"],
		"body": [
			"#include <stdio.h>",
			"",
			"int main(){",
			"\t$0",
			"",
			"\treturn 0;",
			"}"
		],
		"description": "main function"
	},

	"For loop": {
		"scope": "c",
		"prefix": ["@for", "for()"],
		"body": [
			"for (${1:size_t} ${2:i} = 0; ${2:i} < ${3:count}; ${2:i}++){",
			"\t$0",
			"}"
		]
	},

	"Printf":{
		"scope": "c",
		"prefix": ["@printf", "printf()"],
		"body": [
			"printf(\"${1: }\", $2);$0"
		],
		"description": "fastly call the printf format"
	},

	"Scanf":{
		"scope": "c",
		"prefix": ["@scanf", "scanf()"],
		"body": [
			"scanf(\"${1: }\", ${2: });$0"
		],
		"description": "fastly call the scanf format" 
	},

	"Fast Snprintf": {
		"scope": "c",
		"prefix": ["@snp", "snp", "snprintf"],
		"body" : [
			"snprintf(${1:buffer}, ${2:size}, ${3:string}, $4);$0"
		],
		"description": "Snprintf"
	}
}