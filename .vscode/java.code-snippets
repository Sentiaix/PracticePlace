{
	/*
					:::	Rules :::
		'#(sharp)' 접두사를 갖는 경우는 메인 함수/큰 틀을 
		호출할때 쓰는 경우입니다.

		'@(at)' 접두사를 쓰는 경우는 함수 내에서 간단한데
		자주쓰는 내부함수들을 호출할 때 쓰는 경우입니다.
	*/

    "Main Function": {
		"scope" : "java",
		"prefix" : ["#public", "public class"],
		"body": [
			"import java.io.*;",
			"",
			"public class ${TM_FILENAME_BASE} {",
            "\tpublic static void main(String[] args) throws Exception {",
			"\t\tBufferedReader br = new BufferedReader(new InputStreamReader(System.in));",
			"\t\t$0",
			"\t}",
            "}"
		],
		"description": "do first"
	},
	"StringTokenizer": {
		"scope" : "java",
		"prefix" : ["#StrTokenizer", "#tokenizer"],
		"body": [
			"import java.util.StringTokenizer;",
		]
	},
	"Call_StrTokenizer": {
		"scope" : "java",
		"prefix" : ["@StringTokenizer", "@strtokenizer"],
		"body" : [
			"StringTokenizer ${1:st} = new StringTokenizer(br.readLine());",
			"$0",
		],
	},
	"Call_StrBuilder": {
		"scope" : "java",
		"prefix" : ["@StringBuilder", "@strbuilder"],
		"body" : [
			"StringBuilder ${1:sb} = new StringBuilder();",
			"$0",
		],
	},
/* 
	"public static": {
		"scope": "java",
		"prefix": ["##public", "public static"],
		"body": [
			"public static void main(String[] args) {",
			"\t$0",
			"}"
		],
		"description": "do second"
	} */
}